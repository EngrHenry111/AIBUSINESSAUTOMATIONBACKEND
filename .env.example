# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173,https://bislyai.com
API_URL=https://businessai-backend-6g8l.onrender.com

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/bizlyai?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ─── Groq AI ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key
# GROQ_MODEL=llama-3.1-8b-instant

# ─── Python Embedding Service ────────────────────────────────────────────────
EMBEDDING_SERVICE_URL=http://127.0.0.1:8000

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=BizlyAI <onboarding@resend.dev>

# ─── Payments (Paystack) ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret
# Recurring plans — create in dashboard.paystack.com → Plans, then paste the codes
PAYSTACK_STARTER_MONTHLY_CODE=PLN_xxx
PAYSTACK_STARTER_ANNUAL_CODE=PLN_xxx
PAYSTACK_PRO_MONTHLY_CODE=PLN_xxx
PAYSTACK_PRO_ANNUAL_CODE=PLN_xxx
PAYSTACK_BUSINESS_MONTHLY_CODE=PLN_xxx
PAYSTACK_BUSINESS_ANNUAL_CODE=PLN_xxx
# Webhook URL to set on Paystack:
#   https://businessai-backend-6g8l.onrender.com/api/v1/payments/webhook

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# ─── Video calls (Jitsi Meet) ────────────────────────────────────────────────
# Nothing to configure — appointments use public rooms on https://meet.jit.si

# ─── WhatsApp ────────────────────────────────────────────────────────────────
# Sessions are stored on disk under ./whatsapp-sessions (needs a host with Chrome)
